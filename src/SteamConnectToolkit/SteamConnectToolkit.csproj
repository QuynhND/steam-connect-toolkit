<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dự án kiểu SDK dành cho Visual Studio 2022 / dotnet SDK (tuỳ chọn).
    Không bắt buộc: build.ps1 ở thư mục gốc dùng csc.exe có sẵn trong Windows để biên dịch.
    Mã nguồn giữ tương thích C# 5 để csc.exe của .NET Framework biên dịch được.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>5</LangVersion>
    <RootNamespace>SteamConnectToolkit</RootNamespace>
    <AssemblyName>SteamConnectToolkit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\assets\app.ico')">..\..\assets\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
</Project>
